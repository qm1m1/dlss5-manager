<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 项目仅面向 Windows（依赖注册表 / GameFinder），声明后消除平台兼容性警告 -->
    <SupportedOSPlatform>windows</SupportedOSPlatform>
  </PropertyGroup>

  <ItemGroup>
    <!-- 引入 erri120/GameFinder 核心组件与各大平台处理器 -->
    <PackageReference Include="GameFinder.StoreHandlers.Steam" Version="4.0.0" />
    <PackageReference Include="GameFinder.StoreHandlers.EGS" Version="4.0.0" />
    <PackageReference Include="GameFinder.StoreHandlers.GOG" Version="4.0.0" />
    <PackageReference Include="GameFinder.StoreHandlers.Xbox" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 引用 GPU 检测模块（src/GPU） -->
    <ProjectReference Include="..\GPU\DLSS5Manager.GPU.csproj" />
    <!-- 引用 DLL 管理模块（src/DLLManager） -->
    <ProjectReference Include="..\DLLManager\DLSS5Manager.DLLManager.csproj" />
  </ItemGroup>

</Project>
